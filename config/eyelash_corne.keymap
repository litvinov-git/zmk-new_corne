#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB              &kp Q  &kp W  &kp E     &kp R  &kp T                                   &mmv MOVE_UP                     &kp Y      &kp U  &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&mt LEFT_ALT ESCAPE  &kp A  &kp S  &kp D     &kp F  &kp G                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL            &kp Z  &kp X  &kp C     &kp V  &kp B      &mkp RCLK                    &mmv MOVE_DOWN                   &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_BRACKET
                                   &kp LGUI  &td0   &kp SPACE                                                                &kp ENTER  &mo 1  &mo 2
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&rsr_trans>;
        };

        CTRL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &trans          &trans  &kp PG_UP  &kp UP      &kp PG_DN  &kp PRINTSCREEN  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans  &kp LEFT   &kp DOWN    &kp RIGHT  &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE            &trans          &trans  &kp BSPC   &kp INSERT  &kp DEL    &trans           &trans
                        &trans  &trans  &trans                                        &trans  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        SYMB {
            bindings = <
&mo 3   &kp GRAVE  &kp LS(QMARK)  &kp LESS_THAN             &kp MINUS  &kp UNDERSCORE                    &trans          &kp PLUS      &kp EQUAL  &kp GREATER_THAN  &kp PIPE  &kp BSLH  &trans
&trans  &kp N1     &kp N2         &kp N3                    &kp N4     &kp N5                    &trans  &trans  &trans  &kp N6        &kp N7     &kp N8            &kp N9    &kp N0    &trans
&trans  &trans     &trans         &kp LS(LEFT_PARENTHESIS)  &kp LBKT   &kp LS(LBRC)    &trans            &trans          &kp LS(RBRC)  &kp RBKT   &kp LS(RPAR)      &trans    &trans    &trans
                                  &trans                    &trans     &trans                                            &trans        &trans     &trans
            >;
        };

        SYST {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &out OUT_BLE              &trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans  &trans  &trans  &trans  &trans  &trans            &bt BT_PRV  &bt BT_CLR    &bt BT_NXT  &trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                &out OUT_USB              &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans
                        &trans  &trans  &trans                                                  &trans  &trans  &trans
            >;
        };
    };
};
